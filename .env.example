# シールノート 環境変数サンプル
# 本ファイルをコピーして .env を作り、値を埋めてください。
# .env はリポジトリにコミットしないこと（.gitignore 済み）。

# セッション署名用。推測不能なランダム文字列を設定する。
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# DBの絶対パス。PythonAnywhereではスラッシュ4本（絶対パス）。
# 例（本番）: sqlite:////home/<ユーザー名>/data/sealnote.db
# 例（ローカル）: sqlite:///C:/Users/youxi/Desktop/sealnote/data/sealnote.db
DATABASE_URL=

# アプリ全体を守る単一パスワードのハッシュ。平文は絶対に置かないこと。
# 生成例:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('あなたのパスワード'))"
APP_PASSWORD_HASH=

# production で本番設定（DEBUG=False, Secure Cookie 等）が有効になる。
FLASK_ENV=production
